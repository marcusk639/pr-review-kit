{
  "version": 1,
  "project": "recovery-platform",
  "visibility": "public",
  "securityChannel": "advisory",
  "workflowPath": ".github/workflows/claude-code-review.yml",
  "packages": [
    "homegroups/functions",
    "homegroups/mobile",
    "homegroups/web",
    "regroup/functions",
    "regroup/mobile",
    "regroup/web",
    "regroup/e2e",
    "recovery-api",
    "detox-recovery"
  ],
  "knowledge": [
    "checklist.md"
  ],
  "classes": [
    {
      "id": 1,
      "name": "Client-supplied IDs trusted for authorisation or money routing",
      "security": true
    },
    {
      "id": 2,
      "name": "Money paths not exactly-once"
    },
    {
      "id": 3,
      "name": "Dollars vs cents across the wire"
    },
    {
      "id": 4,
      "name": "Plan-cap or entitlement bypass",
      "security": true
    },
    {
      "id": 5,
      "name": "Firestore rules or index drift"
    },
    {
      "id": 6,
      "name": "Callable region mismatch"
    },
    {
      "id": 7,
      "name": "Overly permissive rules and PII exposed through data",
      "security": true
    },
    {
      "id": 8,
      "name": "PII in logs",
      "light": true
    },
    {
      "id": 9,
      "name": "Silent failure reported as success"
    },
    {
      "id": 10,
      "name": "Tests that can't fail"
    },
    {
      "id": 11,
      "name": "Config and environment mistakes",
      "security": true,
      "light": true
    },
    {
      "id": 12,
      "name": "Unbounded reads and fan-out"
    },
    {
      "id": 13,
      "name": "PR text that claims things the code doesn't do",
      "always": true,
      "light": true
    },
    {
      "id": 14,
      "name": "Cross-product isolation violations",
      "security": true,
      "always": true
    }
  ],
  "checks": {
    "piiLogs": {
      "fields": "email|clientEmail|clientName|displayName|phone|sobrietyDate|address|request\\.data|req\\.body",
      "logCall": "\\b(?:logger|console)\\."
    },
    "titleScope": {
      "bareScopes": [
        "mobile",
        "web",
        "functions"
      ]
    },
    "verifyDiff": {
      "script": ".claude/agent-gates/verify-diff.sh"
    }
  },
  "trust": {
    "contextAssociations": [
      "OWNER",
      "MEMBER",
      "COLLABORATOR"
    ]
  }
}
